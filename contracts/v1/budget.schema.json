{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmony.local/contracts/v1/budget.schema.json",
  "title": "Budget",
  "description": "Harmony assignment budget reservation (handoff 06 §5, §12).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "max_model_micro_usd",
    "max_wall_seconds",
    "max_tool_calls"
  ],
  "properties": {
    "max_model_micro_usd": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Positive model spend cap in micro-USD."
    },
    "max_wall_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Positive wall-clock seconds cap."
    },
    "max_tool_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "Positive tool invocation cap."
    }
  }
}
