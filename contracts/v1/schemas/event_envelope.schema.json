{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmony.local/contracts/v1/event_envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "format": "uuid" },
    "aggregate_type": { "type": "string", "minLength": 1, "maxLength": 64 },
    "aggregate_id": { "type": "string", "format": "uuid" },
    "aggregate_version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "causation_id": { "type": ["string", "null"], "format": "uuid" },
    "payload": { "type": "object" }
  }
}
