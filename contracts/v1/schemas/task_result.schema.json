{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmony.local/contracts/v1/task_result.schema.json",
  "title": "TaskResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "attempt_id",
    "generation",
    "outcome",
    "input_hash",
    "result_contract",
    "result_artifact_id",
    "artifact_ids",
    "usage",
    "completed_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "task_id": { "type": "string", "format": "uuid" },
    "attempt_id": { "type": "string", "format": "uuid" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "outcome": { "type": "string", "enum": ["succeeded", "failed", "blocked", "cancelled"] },
    "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "result_contract": { "type": "string", "minLength": 1, "maxLength": 64 },
    "result_artifact_id": { "type": ["string", "null"], "format": "uuid" },
    "artifact_ids": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "format": "uuid" }
    },
    "checkpoint_artifact_ids": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "format": "uuid" }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_micro_usd", "wall_seconds", "tool_calls"],
      "properties": {
        "model_micro_usd": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "wall_seconds": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "tool_calls": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "completed_at": { "type": "string", "format": "date-time" },
    "error": { "$ref": "task_error.schema.json" }
  }
}
