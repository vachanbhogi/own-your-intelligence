{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmony.local/contracts/v1/task_error.schema.json",
  "title": "TaskError",
  "description": "Stable worker error surface for failed or blocked task results (handoff 06 §7, §12).",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "retryable", "message"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Registered stable error code."
    },
    "retryable": {
      "type": "boolean"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Safe explanation; no secrets or stack traces."
    },
    "details_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        { "type": "null" }
      ]
    }
  }
}
