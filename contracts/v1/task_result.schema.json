{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmony.local/contracts/v1/task_result.schema.json",
  "title": "TaskResult",
  "description": "QM task result ingress body (handoff 06 §7, §12).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "attempt_id",
    "generation",
    "outcome",
    "input_hash",
    "result_contract",
    "result_artifact_id",
    "artifact_ids",
    "usage",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "outcome": {
      "type": "string",
      "enum": ["succeeded", "failed", "blocked"]
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_contract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "result_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        { "type": "null" }
      ]
    },
    "artifact_ids": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_micro_usd", "wall_seconds", "tool_calls"],
      "properties": {
        "model_micro_usd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "$ref": "task_error.schema.json"
    },
    "checkpoint_artifact_ids": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "succeeded" } },
        "required": ["outcome"]
      },
      "then": {
        "required": ["result_artifact_id"],
        "properties": {
          "result_artifact_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "enum": ["failed", "blocked"] } },
        "required": ["outcome"]
      },
      "then": {
        "required": ["error"],
        "properties": {
          "error": {
            "$ref": "task_error.schema.json"
          }
        }
      }
    }
  ]
}
