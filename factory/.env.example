# SerpAPI key — https://serpapi.com/
SERPAPI_API_KEY=

# Google Maps place_id (preferred) or data_id from SerpAPI Google Maps
GOOGLE_MAPS_PLACE_ID=
# DATA_ID=

# Optional cap on reviews fetched (default 1000)
# MAX_REVIEWS=1000

# OpenAI-compatible API (Phase 2 clustering + Phase 3 tickets)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Remote GBrain MCP (https://gbrain.io/mcp) — never commit real tokens
GBRAIN_MCP_URL=https://gbrain.io/mcp
GBRAIN_TOKEN=

# Notion features DB (Internal Integration — never commit)
# Create once: Notion → Settings → Integrations → New integration → share DB/page
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Optional: if DATABASE_ID unset, notion-sync creates "Factory features" under this page
# NOTION_PARENT_PAGE_ID=
